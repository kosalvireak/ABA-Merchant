# Port the Express server listens on
PORT=3001

# Where the Vite dev client runs (used for CORS)
CLIENT_ORIGIN=http://localhost:5173

# PayWay credentials, provided by ABA Bank.
# Sandbox: register at https://sandbox.payway.com.kh and they are emailed to you.
# Production: contact paywaysales@ababank.com (your domain must be whitelisted).
PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh
PAYWAY_MERCHANT_ID=your_merchant_id
PAYWAY_API_KEY=your_api_key

# Currency charged on the QR: KHR (default) or USD.
# KHR must be enabled on the merchant profile; sandbox profiles sometimes
# ship with USD only - then set PAYWAY_CURRENCY=USD for testing.
PAYWAY_CURRENCY=KHR
# Only used for USD: riel per USD conversion rate
PAYWAY_USD_RATE=4100

# Optional: public HTTPS URL PayWay can POST payment notifications to.
# Locally you can use a tunnel, e.g. ngrok http 3001 -> https://xxxx.ngrok.io/api/payments/callback
PAYWAY_CALLBACK_URL=

# QR / transaction lifetime in minutes (PayWay minimum is 3)
QR_LIFETIME_MINUTES=5
